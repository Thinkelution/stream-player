{
  "name": "stream-player",
  "version": "0.1.4",
  "description": "OpenStreamPlayer IPTV player with M3U, Xtream, favorites, and EPG support",
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "electron-is-dev": "^2.0.0",
    "hls.js": "^1.4.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.0.5",
    "concurrently": "^8.2.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-devtools-installer": "^3.2.0",
    "wait-on": "^7.0.1"
  },
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron-start": "electron .",
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "build": "node scripts/build-release.cjs && electron-builder",
    "build-mac": "node scripts/build-release.cjs && electron-builder --mac --arm64 --publish never",
    "build-win": "node scripts/build-release.cjs && electron-builder --win"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.openstreamplayer.app",
    "productName": "OpenStreamPlayer",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "sign": "scripts/sign-macos.cjs",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
